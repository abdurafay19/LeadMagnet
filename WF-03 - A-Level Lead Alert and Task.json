    {
      "parameters": {
        "jsCode": "const lead = $('GS - Load Lead Record').first().json;\nconst configRows = $input.all();\n\nconst config = {};\nfor (const row of configRows) {\n  const key = row.json.Key ?? row.json.key;\n  const value = row.json.Value ?? row.json.value;\n  if (key) config[key] = value;\n}\n\nlet weakestCategories = [];\ntry {\n  weakestCategories = JSON.parse(lead.weakest_categories || '[]');\n} catch (e) {\n  weakestCategories = [];\n}\nconst topGaps = weakestCategories.map((w) => w.category).join(', ');\n\nconst slaHours = Number(config.LOOM_SLA_HOURS) || 24;\nconst dueAtUtc = new Date(Date.now() + slaHours * 60 * 60 * 1000).toISOString();\n\nconst sourceLine = lead.campaign ? `${lead.source} / ${lead.campaign}` : lead.source;\nconst sheetId = $('TRG - Execute Workflow Trigger').last().json.sheet_id;\nconst crmLink = config.CRM_LINK_BASE_URL ? `${config.CRM_LINK_BASE_URL}${lead.lead_id}` : `https://docs.google.com/spreadsheets/d/${sheetId}/edit#gid=0 (lead_id: ${lead.lead_id})`;\n\nconst summary = [\n  'NEW A-LEVEL REAL ESTATE LEAD',\n  '',\n  `Name: ${lead.name}`,\n  `Company: ${lead.company_name}`,\n  `Website: ${lead.website}`,\n  `Business type: ${lead.business_type}`,\n  `Team size: ${lead.team_size}`,\n  `Monthly leads: ${lead.monthly_leads}`,\n  `Qualification score: ${lead.qualification_score}/100`,\n  `System health: ${lead.system_health_score}/100`,\n  `Main problem: ${lead.main_problem}`,\n  `Top gaps: ${topGaps}`,\n  `Timeline: ${lead.improvement_timeline}`,\n  `Source: ${sourceLine}`,\n  `Required action: Review website, identify one specific process problem, prepare Loom and contact by ${dueAtUtc}.`,\n  `Lead record: ${crmLink}`\n].join('\\n');\n\nreturn [{ json: {\n  ...lead,\n  config,\n  top_gaps: topGaps,\n  due_at_utc: dueAtUtc,\n  internal_summary: summary\n} }];"
      },
