    {
      "parameters": {
        "jsCode": "const lead = $json;\n// Spec 13.1 idempotency, same pattern as WF-02: Leads.status is the single source of truth\n// (spec 3.2), not execution history. If status has already moved past 'Result sent', WF-03\n// already alerted the owner and created the research task for this lead - do not repeat it.\nconst ALREADY_ALERTED = new Set([\n  'A-level review required', 'Loom prepared', 'Contacted', 'Replied', 'Call booked',\n  'Call completed', 'Proposal required', 'Proposal sent', 'Negotiation', 'Won', 'Lost',\n  'Nurture', 'Unsubscribed', 'Invalid'\n]);\nlet sendEligibility;\nif (!lead.lead_id) {\n  sendEligibility = 'missing';\n} else if (lead.status && ALREADY_ALERTED.has(lead.status)) {\n  sendEligibility = 'already_sent';\n} else {\n  sendEligibility = 'eligible';\n}\nreturn [{ json: { ...lead, send_eligibility: sendEligibility } }];"
      },
