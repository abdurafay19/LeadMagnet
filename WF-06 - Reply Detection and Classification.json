    {
      "parameters": {
        "jsCode": "const item = $input.first().json;\nconst lead = item.lead;\nconst now = new Date().toISOString();\n\nconst needsOwnerAction = ['positive', 'question', 'referral'].includes(item.reply_type);\n\nlet nextAction = lead.next_action;\nlet nextActionAtUtc = lead.next_action_at_utc;\nlet status = lead.status;\n\nif (needsOwnerAction) {\n  nextAction = `Sales owner review required - ${item.reply_type} reply received`;\n  nextActionAtUtc = now;\n  status = 'Replied';\n} else if (item.reply_type === 'out of office') {\n  const reschedule = new Date(Date.now() + 3 * 24 * 60 * 60 * 1000).toISOString();\n  nextActionAtUtc = reschedule;\n  nextAction = 'Resume follow-up sequence after out-of-office period';\n} else if (item.reply_type === 'negative' || item.reply_type === 'not now') {\n  status = 'Nurture';\n  nextAction = 'Light nurture only - prospect declined or deferred for now';\n  nextActionAtUtc = '';\n} else {\n  nextAction = 'Manual review - reply could not be auto-classified';\n  nextActionAtUtc = now;\n}\n\nreturn [{ json: {\n  lead_id: lead.lead_id,\n  work_email: lead.work_email,\n  replied: true,\n  reply_type: item.reply_type,\n  reply_excerpt: item.body_excerpt,\n  thread_link: item.thread_link,\n  message_id: item.message_id,\n  status,\n  next_action: nextAction,\n  next_action_at_utc: nextActionAtUtc,\n  last_activity_at_utc: now,\n  needs_owner_action: needsOwnerAction,\n  owner_email: item.config.OWNER_EMAIL || '',\n  company_name: lead.company_name\n} }];"
      },
