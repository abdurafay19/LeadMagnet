      "name": "TRG - Gmail Trigger",
      "type": "n8n-nodes-base.gmailTrigger",
      "typeVersion": 1.2,
      "position": [
        -2864,
        400
      ]
    },
    {
      "parameters": {
        "jsCode": "const msg = $input.first().json;\n\n// n8n's Gmail Trigger (simple: false) returns 'from' as a parsed address object, not a plain\n// string - e.g. {text: 'Name <addr>', value: [{address, name}]} - so String(fromHeader) on the\n// raw field was stringifying an object into the literal text '[object Object]' instead of the\n// address. Pull a real string out of whichever shape is actually present before regexing it.\nfunction toAddressString(field) {\n  if (!field) return '';\n  if (typeof field === 'string') return field;\n  if (typeof field === 'object') {\n    if (typeof field.text === 'string') return field.text;\n    if (Array.isArray(field.value) && field.value[0]) return field.value[0].address || field.value[0].name || '';\n    if (typeof field.address === 'string') return field.address;\n  }\n  return '';\n}\nconst fromHeader = toAddressString(msg.from) || toAddressString(msg.headers?.from) || '';\nconst emailMatch = String(fromHeader).match(/[\\w.+-]+@[\\w-]+(?:\\.[\\w-]+)*\\.[a-zA-Z]{2,}/);\nconst senderEmail = (emailMatch ? emailMatch[0] : String(fromHeader)).trim().toLowerCase();\n\nconst subject = msg.subject || msg.headers?.subject || '';\nconst bodyRaw = msg.textPlain || msg.snippet || msg.text || '';\nconst bodyExcerpt = String(bodyRaw).replace(/\\s+/g, ' ').trim().slice(0, 300);\n\nconst threadId = msg.threadId || '';\nconst messageId = msg.id || '';\nconst threadLink = threadId ? `https://mail.google.com/mail/u/0/#inbox/${threadId}` : '';\n\n// In-Reply-To (falling back to the last id in References) identifies which outbound message\n// this is a reply to, so the resolution chain below can look that message up by rfc822msgid\n// and read its X-Client-Sheet-Id header - that's how we know which client's spreadsheet to use.\nconst inReplyToHeader = msg['in-reply-to'] || msg.headers?.['in-reply-to'] || '';\nconst referencesHeader = msg.references || msg.headers?.references || '';\nfunction lastMessageId(raw) {\n  const ids = String(raw).match(/<[^<>]+>/g) || [];\n  return ids.length ? ids[ids.length - 1].replace(/[<>]/g, '').trim() : '';\n}\nconst inReplyTo = lastMessageId(inReplyToHeader) || lastMessageId(referencesHeader);\n\nreturn [{ json: {\n  sender_email: senderEmail,\n  subject,\n  body_excerpt: bodyExcerpt,\n  thread_id: threadId,\n  message_id: messageId,\n  thread_link: threadLink,\n  in_reply_to: inReplyTo,\n  received_at_utc: new Date().toISOString()\n} }];"
      },
      "id": "0e6df522-54c4-4634-ad8e-5b3e90032513",
      "name": "CODE - Normalize Reply Email",
