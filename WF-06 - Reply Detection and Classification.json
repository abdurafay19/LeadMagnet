    {
      "parameters": {
        "jsCode": "const item = $('CODE - Merge Config and Classification').first().json;\nconst priorActivity = $input.all();\n\nconst alreadyProcessed = priorActivity.some((row) => {\n  if (!['reply_received', 'unsubscribed'].includes(row.json.event_type)) return false;\n  try {\n    const details = JSON.parse(row.json.details || '{}');\n    return item.message_id && details.message_id === item.message_id;\n  } catch {\n    return false;\n  }\n});\n\nreturn [{ json: { ...item, already_processed: alreadyProcessed } }];"
