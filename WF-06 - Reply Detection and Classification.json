    {
      "parameters": {
        "jsCode": "const item = $input.first().json;\nconst text = `${item.subject} ${item.body_excerpt}`.toLowerCase();\n\nfunction includesAny(str, words) {\n  return words.some((w) => str.includes(w));\n}\n\nlet replyType = 'unknown';\n\nif (includesAny(text, ['unsubscribe', 'remove me', 'stop emailing', 'opt out', 'opt-out', 'do not contact'])) {\n  replyType = 'unsubscribe';\n} else if (includesAny(text, ['out of office', 'automatic reply', 'auto-reply', 'currently away', 'on vacation', \"i'm out\", 'i am out of the office'])) {\n  replyType = 'out of office';\n} else if (includesAny(text, ['not interested', 'no thanks', 'no thank you', 'please stop', 'remove from your list', 'not a fit'])) {\n  replyType = 'negative';\n} else if (includesAny(text, ['not now', 'maybe later', 'check back', 'follow up later', 'revisit this', 'next quarter', 'not right now'])) {\n  replyType = 'not now';\n} else if (includesAny(text, ['you should talk to', 'reach out to', 'introduce you to', 'better person for this', 'my colleague'])) {\n  replyType = 'referral';\n} else if (includesAny(text, ['?', 'how does', 'what is', 'can you explain', 'could you tell me', 'how much', 'how long'])) {\n  replyType = 'question';\n} else if (includesAny(text, ['interested', 'yes', 'sounds good', \"let's talk\", 'book a call', 'schedule a call', 'sounds great', 'would love to', \"let's chat\"])) {\n  replyType = 'positive';\n}\n\nreturn [{ json: { ...item, reply_type: replyType } }];"
      },
