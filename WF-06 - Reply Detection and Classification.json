    {
      "parameters": {
        "jsCode": "const submission = $('CODE - Normalize Reply Email').first().json;\nconst matches = $input.all();\n// alwaysOutputData guarantees at least one item even on a zero-match filter, so\n// 'matches.length > 0' is always true and cannot be used to detect \"no match\" - the\n// returned row's own work_email must be checked against what was actually searched for.\n// Live testing (2026-07-31) caught this exact gap: an unmatched reply produced a Leads\n// row with a blank lead_id instead of being routed to the unmatched-reply branch.\nconst rawLead = matches.length > 0 ? matches[0].json : null;\nconst lead = (rawLead && rawLead.lead_id && rawLead.work_email === submission.sender_email) ? rawLead : null;\n\nreturn [{ json: { ...submission, lead_found: !!lead, lead } }];"
      },
