      "parameters": {
        "jsCode": "const rows = $input.all();\nconst config = {};\nfor (const row of rows) {\n  const key = row.json.Key ?? row.json.key;\n  const value = row.json.Value ?? row.json.value;\n  if (key) config[key] = value;\n}\nreturn [{ json: { config } }];"
