      "id": "b5d100be-b194-40fa-b657-8f8cabd272b3",
      "name": "GS - Read All Leads",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [
        2944,
        2816
      ],
      "credentials": {
        "googleSheetsOAuth2Api": {
          "id": "jhDJDAFgHrbckJK6",
          "name": "Google Sheets account 2"
        }
