    {
      "parameters": {
        "jsCode": "const items = $('GS - Read All Leads').all();\nconst now = new Date();\n\nconst terminalStatuses = ['Won', 'Lost', 'Unsubscribed', 'Invalid', 'A-level review required', 'Loom prepared', 'Contacted', 'Call completed', 'Proposal required', 'Proposal sent', 'Negotiation'];\nconst stopBookingStatuses = ['booked', 'completed', 'cancelled'];\nconst MAX_FOLLOWUP_STEP = 3;\n\nconst eligible = items.filter((item) => {\n  const lead = item.json;\n\n  const isSuppressed = lead.suppressed === true || String(lead.suppressed).toLowerCase() === 'true';\n  if (isSuppressed) return false;\n\n  if (terminalStatuses.includes(lead.status)) return false;\n  if (['won', 'lost'].includes(String(lead.deal_status || '').toLowerCase())) return false;\n  if (stopBookingStatuses.includes(String(lead.booking_status || '').toLowerCase())) return false;\n\n  const replied = lead.replied === true || String(lead.replied).toLowerCase() === 'true';\n  if (replied) {\n    // Spec 6.2 enum spells this 'out of office' (spaces). Normalizing away underscores/hyphens\n    // makes this match regardless of which exact form WF-06 (Reply Detection) writes.\n    const isOutOfOffice = String(lead.reply_type || '').toLowerCase().replace(/[_-]/g, ' ').trim() === 'out of office';\n    if (!isOutOfOffice) return false;\n    if (!lead.next_action_at_utc) return false;\n  }\n\n  const followupStep = Number(lead.followup_step) || 0;\n  if (followupStep >= MAX_FOLLOWUP_STEP) return false;\n\n  if (!lead.next_action_at_utc) return false;\n  const dueAt = new Date(lead.next_action_at_utc);\n  if (isNaN(dueAt.getTime()) || dueAt > now) return false;\n\n  return true;\n});\n\nreturn eligible;"
      },
      "id": "9ee3919a-0471-4f24-8f5e-b0aeaa44e9cb",
      "name": "CODE - Filter Due and Eligible Leads",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        3152,
        2816
      ]
    },
    {
      "parameters": {
        "options": {
          "reset": false
        }
      },
      "id": "033b7753-d1a3-41ec-b58e-d66cbcbe8dc5",
      "name": "LOOP - Split In Batches",
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 3,
      "position": [
        3376,
        2816
      ],
      "executeOnce": false
    },
    {
      "parameters": {
        "jsCode": "const lead = $('LOOP - Split In Batches').first().json;\nconst config = $('CODE - Parse Config').first().json.config;\nconst templateRows = $('GS - Load Email Templates').all();\n\n// Idempotency relies solely on Leads.followup_step/next_action_at_utc (spec 3.2: the Leads\n// row is the single source of truth, not execution/activity history) - CODE - Filter Due and\n// Eligible Leads already only lets a lead reach this loop if it is genuinely due, so no\n// separate Activity_Log lookup is needed here.\n\nlet weakestCategories = [];\ntry { weakestCategories = JSON.parse(lead.weakest_categories || '[]'); } catch (e) { weakestCategories = []; }\nconst weakness1 = weakestCategories[0]?.category || 'your current lead process';\n\n// WF-01 stores lead_sources as a comma-separated string (spec 6.2: 'Comma-separated labels or\n// JSON array'), not JSON - parsing it as JSON here previously always threw, was swallowed, and\n// silently fell back to the generic 'your lead sources' phrase on every single follow-up.\nconst leadSources = String(lead.lead_sources || '').split(',').map((s) => s.trim()).filter(Boolean);\nconst relevantSource = leadSources[0] || 'your lead sources';\n\n// lead_storage is stored lowercased for WF-01 scoring purposes; map back to natural phrasing\n// instead of dropping raw values like 'crm' or 'different systems' into customer-facing copy.\nconst STORAGE_DISPLAY = {\n  crm: 'your CRM',\n  'property software': 'your property software',\n  sheets: 'your spreadsheet',\n  email: 'your email inbox',\n  'different systems': 'your different systems',\n  'not sure': 'your current system'\n};\nconst currentSystem = STORAGE_DISPLAY[String(lead.lead_storage || '').toLowerCase()] || 'your current system';\n\nconst followupStep = Number(lead.followup_step) || 0;\nconst stepNumber = followupStep + 1;\nconst firstName = (lead.name || '').trim().split(/\\s+/)[0] || lead.name || '';\n\nconst templateId = `followup_step_${Math.min(stepNumber, 3)}`;\nconst template = templateRows.map((r) => r.json).find((r) => (r.template_id ?? r.Template_ID) === templateId);\n\nif (!template) {\n  throw new Error(`WF-04: No Email_Templates row found for template_id \"${templateId}\". Add it to the Email_Templates tab before sending.`);\n}\n\n// Token names match the literal {{...}} placeholders in the approved followup_step_1/2/3 rows.\nconst tokens = {\n  'First Name': firstName,\n  'Weakness 1': weakness1,\n  'Relevant Source': relevantSource,\n  'Current System': currentSystem,\n  'Main Problem': lead.main_problem || ''\n};\n\nfunction fillTemplate(str, map) {\n  // Same fix as WF-02: the live Email_Templates sheet has inconsistent token casing between\n  // fields, so token matching must be case/spacing-insensitive rather than an exact string match.\n  const normalize = (s) => String(s).toLowerCase().replace(/[_\\s]+/g, ' ').trim();\n  const normalizedMap = {};\n  for (const k in map) normalizedMap[normalize(k)] = map[k];\n  return String(str ?? '').replace(/\\{\\{\\s*([^}]+?)\\s*\\}\\}/g, (match, key) => {\n    const normalizedKey = normalize(key);\n    return Object.prototype.hasOwnProperty.call(normalizedMap, normalizedKey) ? String(normalizedMap[normalizedKey] ?? '') : match;\n  });\n}\n\nconst subject = fillTemplate(template.subject, tokens);\nconst body = fillTemplate(template.body, tokens);\n\nreturn [{ json: {\n  ...lead,\n  config,\n  followup_subject: subject,\n  followup_body: body,\n  step_number: stepNumber\n} }];"
      },
      "id": "9af8b82e-2e8d-49d9-8cd6-2e533ff504ec",
      "name": "CODE - Build Follow-up Message",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        3616,
        2960
      ]
    },
    {
      "parameters": {
        "jsCode": "const lead = $json;\nconst stripCRLF = (s) => String(s ?? '').replace(/[\\r\\n]+/g, ' ').trim();\n\nconst to = stripCRLF(lead.work_email);\nconst subject = stripCRLF(lead.followup_subject);\nconst body = String(lead.followup_body ?? '');\nconst type = stripCRLF($('GD - Search File').last().json.name);\nconst sheetId = stripCRLF($('GD - Search File').last().json.id);\n\n// RFC 2047-encode the subject in case it contains non-ASCII characters.\nconst encodedSubject = /[^\\x00-\\x7F]/.test(subject)\n  ? `=?UTF-8?B?${Buffer.from(subject, 'utf-8').toString('base64')}?=`\n  : subject;\n\n// X-Client-Type/X-Client-Sheet-Id let WF-06 resolve which client's spreadsheet a reply\n// belongs to (via the original message's headers, looked up by In-Reply-To) without having\n// to search every client folder. stripCRLF on every interpolated value prevents header\n// injection, since work_email ultimately traces back to untrusted form input in WF-01.\nconst headers = [\n  `To: ${to}`,\n  `Subject: ${encodedSubject}`,\n  'MIME-Version: 1.0',\n  'Content-Type: text/plain; charset=\"UTF-8\"',\n  `X-Client-Type: ${type}`,\n  `X-Client-Sheet-Id: ${sheetId}`\n];\n\nconst rawMessage = headers.join('\\r\\n') + '\\r\\n\\r\\n' + body;\nconst encoded = Buffer.from(rawMessage, 'utf-8').toString('base64')\n  .replace(/\\+/g, '-')\n  .replace(/\\//g, '_')\n  .replace(/=+$/, '');\n\nreturn [{ json: { ...lead, raw: encoded } }];"
      },
      "id": "5c9dab2e-7f4b-4a1d-9e5c-3b4c5d6e7f80",
      "name": "CODE - Build Raw Email",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        3840,
