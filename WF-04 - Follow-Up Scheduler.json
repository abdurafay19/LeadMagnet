      "id": "6dabce3f-8a5c-4b2e-af6d-4c5d6e7f8091",
      "name": "HTTP - Send Follow-up Email",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        3840,
        3060
      ],
      "credentials": {
        "gmailOAuth2": {
          "id": "K0aEhfZvTx9f7hTm",
          "name": "Gmail account"
        }
      },
      "notes": "Sends via the raw Gmail API instead of the standard Gmail node so a custom X-Client-Type/X-Client-Sheet-Id header can be set on the outgoing message - the standard Gmail node's send operation has no option to set custom headers. Response shape ({id, threadId, labelIds}) matches what the Gmail node used to return, so CODE - Compute Update Fields needed no changes."
    },
    {
      "parameters": {
        "jsCode": "const built = $('CODE - Build Follow-up Message').first().json;\nconst sendResult = $input.first().json;\nconst config = built.config;\nconst newStep = built.step_number;\nconst now = new Date().toISOString();\n\nfunction addBusinessDays(date, days) {\n  const result = new Date(date);\n  let added = 0;\n  while (added < days) {\n    result.setDate(result.getDate() + 1);\n    const day = result.getDay();\n    if (day !== 0 && day !== 6) added++;\n  }\n  return result;\n}\n\nconst anchor = new Date(built.created_at_utc || built.last_activity_at_utc || now);\nconst followupDaysMap = {\n  1: Number(config.FOLLOWUP_2_DAYS) || 7,\n  2: Number(config.FOLLOWUP_3_DAYS) || 12\n};\n\nlet nextActionAtUtc = '';\nlet nextAction = '';\nlet status = built.status;\n\nif (newStep < 3 && followupDaysMap[newStep]) {\n  nextActionAtUtc = addBusinessDays(anchor, followupDaysMap[newStep]).toISOString();\n  nextAction = `Send follow-up step ${newStep + 1}`;\n} else {\n  nextActionAtUtc = '';\n  nextAction = 'Follow-up sequence complete - move to light nurture';\n  status = 'Nurture';\n}\n\nreturn [{ json: {\n  lead_id: built.lead_id,\n  followup_step: newStep,\n  next_action: nextAction,\n  next_action_at_utc: nextActionAtUtc,\n  status,\n  last_activity_at_utc: now,\n  followup_message_id: sendResult.id || ''\n} }];"
      },
