      "id": "gs-check-prior-booking-activity",
      "name": "GS - Check Prior Booking Activity",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [
        -224,
        320
      ],
      "alwaysOutputData": true,
      "notes": "Spec 13.1 idempotency: booking webhooks are commonly retried by the provider on a slow/timed-out response. Without this check a retry would send a duplicate owner-notification email and duplicate Activity_Log entry for the same event.",
      "credentials": {
        "googleSheetsOAuth2Api": {
          "id": "jhDJDAFgHrbckJK6",
          "name": "Google Sheets account 2"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const item = $('CODE - Merge Config and Lead Info').first().json;\nconst priorActivity = $input.all();\nconst isCancellation = String(item.raw_event_type || '').toLowerCase().includes('cancel');\n// Cal.com's BOOKING_RESCHEDULED keeps the same booking_uid as the original BOOKING_CREATED,\n// so it needs its own event_type - otherwise it would match the original 'booking_created'\n// activity row on booking_uid alone and get silently treated as already processed, and the\n// lead's next_action_at_utc would never move to the new meeting time.\nconst isReschedule = String(item.raw_event_type || '').toLowerCase().includes('reschedul');\nconst targetEventType = isCancellation ? 'booking_cancelled' : isReschedule ? 'booking_rescheduled' : 'booking_created';\n\nconst alreadyProcessed = priorActivity.some((row) => {\n  if (row.json.event_type !== targetEventType) return false;\n  try {\n    const details = JSON.parse(row.json.details || '{}');\n    if (!item.booking_uid || details.booking_uid !== item.booking_uid) return false;\n    // A second reschedule reuses the same booking_uid again, so also compare meeting_start_utc -\n    // a genuine new reschedule has a new start time and must not be deduped against the first one.\n    if (targetEventType === 'booking_rescheduled') return details.meeting_start_utc === item.meeting_start_utc;\n    return true;\n  } catch {\n    return false;\n  }\n});\n\nreturn [{ json: { ...item, is_reschedule: isReschedule, already_processed: alreadyProcessed } }];"
      },
