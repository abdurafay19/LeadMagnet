      "parameters": {
        "jsCode": "const base = $('CODE - Normalize Booking Payload').first().json;\nconst current = $json;\nconst sheetId = (current && current.id) ? current.id : '';\n\n// Falls back to the root template/ops spreadsheet when client_type is blank, the client\n// folder doesn't exist, or the folder has no matching spreadsheet inside it. GS - Lookup\n// Lead by Email will then correctly find no match there, and the existing unmatched-booking\n// handling (GS - Log Unmatched Booking) takes over from that point on.\nconst ROOT_FALLBACK_SHEET_ID = '1P9gpsLp0PKTV8PN9kQ-0E-6qy_ZQStmnJbh7ehtiu6M';\n\nreturn [{ json: { ...base, sheet_id: sheetId || ROOT_FALLBACK_SHEET_ID } }];"
      },
