    {
      "parameters": {
        "jsCode": "const found = $('CODE - Check Lead Found').first().json;\nconst configRows = $input.all();\n\nconst config = {};\nfor (const row of configRows) {\n  const key = row.json.Key ?? row.json.key;\n  const value = row.json.Value ?? row.json.value;\n  if (key) config[key] = value;\n}\n\nreturn [{ json: { ...found, config } }];"
      },
