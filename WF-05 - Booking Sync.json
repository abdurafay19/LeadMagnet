    {
      "parameters": {
        "jsCode": "const body = $input.first().json.body ?? $input.first().json;\n\n// Cal.com webhook shape: { triggerEvent, createdAt, payload: { organizer, attendees: [...],\n// title, startTime, endTime, uid, responses: { <questionIdentifier>: { label, value } } } }.\n// Custom booking questions can come back either as a {label, value} object or a plain string\n// depending on question type/Cal.com version, so both are handled below.\nconst payload = body.payload || {};\nconst attendee = (Array.isArray(payload.attendees) && payload.attendees[0]) || {};\nconst responses = payload.responses || {};\n\n// 'client_type' is the identifier of a hidden/prefilled custom booking question on the Cal.com\n// event type - the Booking_URL sent in WF-02/WF-04 emails appends ?client_type={{type}} so the\n// booker's chosen client folder round-trips back through the booking without them touching it.\nconst rawClientType = responses.client_type;\nconst clientType = (rawClientType && typeof rawClientType === 'object') ? (rawClientType.value ?? '') : (rawClientType ?? '');\n\nconst inviteeEmail = String(attendee.email || '').trim().toLowerCase();\nconst meetingStartUtc = payload.startTime || '';\nconst inviteeTimezone = attendee.timeZone || '';\nconst eventName = payload.title || 'Discovery call';\nconst bookingUid = payload.uid || '';\nconst rawEventType = body.triggerEvent || '';\n\nreturn [{ json: {\n  invitee_email: inviteeEmail,\n  meeting_start_utc: meetingStartUtc,\n  invitee_timezone: inviteeTimezone,\n  event_name: eventName,\n  booking_uid: bookingUid,\n  raw_event_type: rawEventType,\n  client_type: String(clientType).trim()\n} }];"
      },
      "id": "b4f92389-4a44-42ea-a350-7d6c1e56c73b",
