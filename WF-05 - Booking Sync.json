    {
      "parameters": {
        "jsCode": "const item = $input.first().json;\nconst config = item.config;\nconst lead = item.lead;\n\nconst timezone = item.invitee_timezone || config.DEFAULT_TIMEZONE || 'America/New_York';\n\nfunction formatLocal(utcIso, tz) {\n  if (!utcIso) return '';\n  try {\n    return new Date(utcIso).toLocaleString('en-US', { timeZone: tz, dateStyle: 'full', timeStyle: 'short' });\n  } catch (e) {\n    return utcIso;\n  }\n}\n\nconst meetingStartUtc = item.meeting_start_utc;\nconst meetingStartLocal = formatLocal(meetingStartUtc, timezone);\nconst now = new Date().toISOString();\nconst isReschedule = !!item.is_reschedule;\n\nreturn [{ json: {\n  lead_id: lead.lead_id,\n  company_name: lead.company_name,\n  booking_status: 'booked',\n  status: 'Call booked',\n  next_action: isReschedule ? 'Call rescheduled: review updated meeting time' : 'Prepare for call: review lead record and main problem before the meeting',\n  next_action_at_utc: meetingStartUtc || now,\n  meeting_start_utc: meetingStartUtc,\n  meeting_start_local: meetingStartLocal,\n  meeting_timezone: timezone,\n  event_name: item.event_name,\n  last_activity_at_utc: now,\n  owner_email: config.OWNER_EMAIL || '',\n  booking_uid: item.booking_uid || '',\n  is_reschedule: isReschedule,\n  event_type: isReschedule ? 'booking_rescheduled' : 'booking_created'\n} }];"
      },
