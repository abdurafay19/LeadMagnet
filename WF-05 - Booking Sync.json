    {
      "parameters": {
        "jsCode": "const submission = $('CODE - Normalize Booking Payload').first().json;\nconst matches = $input.all();\n// alwaysOutputData guarantees at least one item even on a zero-match filter, so\n// 'matches.length > 0' is always true and cannot be used to detect \"no match\" - the\n// returned row's own work_email must be checked against what was actually searched for\n// (same class of bug found live-testing WF-01's lookups on 2026-07-31).\nconst rawLead = matches.length > 0 ? matches[0].json : null;\nconst lead = (rawLead && rawLead.lead_id && rawLead.work_email === submission.invitee_email) ? rawLead : null;\n\nreturn [{ json: { ...submission, lead_found: !!lead, lead } }];"
      },
